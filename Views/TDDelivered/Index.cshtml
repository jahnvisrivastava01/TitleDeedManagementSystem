@model IEnumerable<TitleDeedManagementSystem.Models.TitleDeedEntry>

@{
    ViewData["Title"] = "Delivered Title Deeds";
}

<div class="card">
    <div class="card-header">
        <h4> Delivered Title Deeds </h4>
    </div>

    <div class="card-body">


        @if (Model.Any())
        {
            <table class="table table-bordered table-hover">

                <thead>
                    <tr>
                        <th>Account Number</th>
                        <th>CIF Number</th>
                        <th>Account Holder</th>
                        <th>Collateral Number</th>
                        <th>Title Deed Number</th>
                        <th> Status</th>
                        <th>Delivered On</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <a href="#"
                                   class="details-link"
                                   data-id="@item.TitleDeedEntryId">

                                    @(item.Collateral?.Account?.AccountNumber ?? "-")

                                </a>
                            </td>

                            <td>@(item.Collateral?.Account?.CIFNumber ?? "-")</td>

                            <td>@(item.Collateral?.Account?.AccountHolderName ?? "-")</td>

                            <td>@(item.Collateral?.CollateralNumber ?? "-")</td>

                            <td>@item.TitleDeedNumber</td>

                            <td>@item.TdDeliveryStatus</td>
                            <td>@item.ModifiedDate?.ToString("dd-MM-yyyy")</td>

                            <td>
                                <a href="#" class="btn btn-primary btn-sm details-link"
                                 data-id ="@item.TitleDeedEntryId">
                                 Details

                               </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            <hr />

            <div class="modal fade"
                 id="detailsModal"
                 tabindex="-1"
                 aria-hidden="true">

                <div class="modal-dialog modal-lg modal-dialog-scrollable">

                    <div class="modal-content">

                        <div class="modal-header">

                            <h5 class="modal-title">
                                Delivered Title Deeds Details
                            </h5>

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="modal">
                            </button>

                        </div>

                        <div class="modal-body"
                             id="detailsContainer">
                        </div>

                    </div>

                </div>

            </div>
        }
        else
        {
            <div class="alert alert-info">
                No delivered title deeds found.
            </div>
        }

    </div>
</div>

@section PageScripts
{
    <script>

        $(document).ready(function () {

            $(".details-link").click(function (e) {

                e.preventDefault();

                var id = $(this).data("id");

                $.ajax({

                    url: '@Url.Action("Details", "TDDelivered")',

                    type: 'GET',

                    data: {
                        id: id
                    },

                    success: function (result) {

                        $("#detailsContainer").html(result);

                        var modal = new bootstrap.Modal(
                            document.getElementById("detailsModal"));

                        modal.show();

                    },

                    error: function () {

                        alert("Unable to load delivered title deed details.");

                    }

                });

            });

        });

    </script>
}


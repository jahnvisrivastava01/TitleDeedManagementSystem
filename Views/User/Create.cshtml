@model TitleDeedManagementSystem.ViewModels.UserCreateViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create User";
}

<h2>Create User</h2>

<form asp-action="Create" method="post">
  <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label>Employee ID</label>
        <input asp-for="EmployeeId" class="form-control" />

        <span asp-validation-for="EmployeeId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>User Name</label>
        <input asp-for="UserName" class="form-control" />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>

    <div class="mb-3">
      <label asp-for= "Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
      <label>Password</label>
      <input asp-for ="Password" class="form-control" type="password"/>
      <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DesignationId" class="form-label">Designation</label>

        <select asp-for="DesignationId"
                id="designation"
                asp-items="@(new SelectList(ViewBag.Designations, "DesignationId", "DesignationName"))"
                class="form-select">

            <option value="">Select Designation</option>

        </select>
        <span asp-validation-for="DesignationId" class="text-danger"></span>
    </div>

    <div class="mb-3" id="makerRole" style="display:none;">
        <label class="form-label">Role</label>
        <input type="text" class="form-control" value="Maker" readonly /> </div>
    

    <div class="mb-3" id="checkerRoles" style="display:none;">
        <label class="form-label">Select Checker Roles</label>

        @foreach (var role in ViewBag.Roles)
        {
            if (role.RoleName != "Maker")
            {
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="SelectedRoleIds"
                           value="@role.RoleId" />

                    <label class="form-check-label">
                        @role.RoleName
                    </label>
                </div>
            }
        }
      
    </div>

    <div class="mb-3">
        <label asp-for="BranchId" class="form-label">Branch</label>

        <select asp-for="BranchId"
                asp-items="@(new SelectList(ViewBag.Branches, "BranchId", "BranchName"))"
                class="form-select">

            <option value="">Select Branch</option>

        </select>
        <span asp-validation-for="BranchId" class="text-danger"></span>
    </div>

    
    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">
            Active
        </label>
    </div>

    <button type="submit" class="btn btn-primary">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>



    

</form>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.getElementById("designation").addEventListener("change", function () {

            var designation = this.options[this.selectedIndex].text;

            if (designation === "Assistant Manager" ||
                designation === "Deputy Manager") {

                document.getElementById("makerRole").style.display = "block";
                document.getElementById("checkerRoles").style.display = "none";
            }
            else {

                document.getElementById("makerRole").style.display = "none";
                document.getElementById("checkerRoles").style.display = "block";
            }
        });
    </script>
}

   
    



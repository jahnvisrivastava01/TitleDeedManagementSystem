@model TitleDeedManagementSystem.Models.User
@using Microsoft.AspNetCore.Mvc.Rendering

<h2>Assign Role</h2>

<form asp-action="AssignRole" method="post">

    <input type="hidden" name="userId" value="@Model.UserId" />

    <div class="mb-3">
        <label>User Name</label>
        <input value="@Model.UserName" class="form-control" readonly />
    </div>

    @if (Model.Designation.DesignationName == "Assistant Manager" || Model.Designation.DesignationName == " Deputy Manager")
        {
            <div class="mb-3">
              <label>Role</label>
              <input type="text" class="form-control" value="Maker" readonly/>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label>Select Role</label>
                @foreach(var role in ViewBag.Roles)
                {
                    if (role.RoleName != "Maker" && role.RoleName !="Branch Admin")
                    {
                        <div class="form-check">
                          <input class="form-check-input"
                                type="checkbox"
                                name="roleIds"
                                value="@role.RoleId"
                        @(Model.UserRoles.Any(ur => ur.RoleId == role.RoleId) ? "checked" : "") />

                        <label class="form-check-label">
                          @role.RoleName
                        </label>

                        </div>
                    }

                }
             </div>
         }

   

    <button type="submit" class="btn btn-primary">
        Save Role
    </button>

</form>

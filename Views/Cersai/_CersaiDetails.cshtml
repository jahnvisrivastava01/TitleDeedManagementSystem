@model TitleDeedManagementSystem.ViewModel.CersaiSatisfactionViewModel


<form asp-action="SaveCersaiSatisfaction" asp-controller="Cersai" method="post">
  <input type="hidden" asp-for="TitleDeedEntryId"/>
  <input type="hidden" asp-for="CollateralId"/>


  <div class="row">
    <div class="col-md-6 mb-3">
      <label asp-for="CollateralNumber" class="form-label"></label>
      <input asp-for="CollateralNumber"class="form-control" readonly/>



    </div>

    <div class="col-md-6 mb-3">

      <label asp-for="TitleDeedNumber" class="form-label"></label>
      <input asp-for="TitleDeedNumber" class="form-control" readonly/>
    </div>





  </div>

  <div  class="row">
    <div class="col-md-6 mb-3">
      <label asp-for="CERSAIAssetId" class="form-label"></label>
      <input asp-for="CERSAIAssetId" class="form-control" readonly/>
    </div>

    <div class="col-md-6 mb-3">
      <label asp-for="CersaiSatisfactionDate" class="form-label"></label>
      <input asp-for="CersaiSatisfactionDate" type="date" class="form-control"/>
      <span asp-validation-for="CersaiSatisfactionDate" class="text-danger"></span>
    </div>

  </div>

  <div class="mt-3">
    <button type="submit" class="btn btn-primary">
      Save
    </button>
  </div>
</form>
